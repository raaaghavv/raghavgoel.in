# Canonical site URL used for metadata, sitemap, robots and llms.txt
NEXT_PUBLIC_SITE_URL=https://raghavgoel.in

# Optional: where the contact form posts (JSON: name, email, message), e.g. https://formspree.io/f/xxxxxxx
# Leave empty and the form opens the visitor's email app with the message filled in.
NEXT_PUBLIC_CONTACT_ENDPOINT=
